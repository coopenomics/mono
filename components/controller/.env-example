NODE_ENV=development

# Публичный URL контроллера (API): на деве обычно порт 2998; на проде может быть https://домен/backend
BACKEND_URL=http://127.0.0.1:2998
# Публичный URL рабочего стола (SPA): письма, приглашения, deep links в ICS
FRONTEND_URL=http://127.0.0.1:2999

# Port number
PORT=2998

SERVER_SECRET=SECRET

SOCKET_SERVER=http://localhost:2222
# URL of the Mongo DB
MONGODB_URL=mongodb://127.0.0.1:27017/cooperative-x
COOPNAME=voskhod

# JWT
# JWT secret key
JWT_SECRET=thisissecret
# Number of minutes after which an access token expires
# Токен доступа живёт коротко и незаметно продлевается обновляющим токеном.
# Раньше здесь стояло 864000 минут — шестьсот дней: обновления на фронте не было,
# и срок жизни токена был единственным, что удерживало сессию. Теперь обновление
# работает, и длинный срок означал бы только одно — украденный токен годен два года.
JWT_ACCESS_EXPIRATION_MINUTES=30
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=365
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP configuration options for the email service
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="'КО-ПОЧТАЛЬОН' <mail@coopenomics.world>"

# Напоминатель об отчёте по авансу под отчёт (extensions/expenses).
# Интервал тика сканера зеркала расходов (мс). Дефолт 6 ч. Письмо пайщику —
# не чаще раза в неделю (троттлит идемпотентность Центра уведомлений).
EXPENSE_ADVANCE_REMINDER_INTERVAL_MS=21600000
# Сколько дней аванс может висеть без отчёта до первого напоминания. Дефолт 3.
EXPENSE_ADVANCE_REMINDER_GRACE_DAYS=3

# BLOCKHAIN
BLOCKCHAIN_RPC=http://127.0.0.1:8888
CHAIN_ID=cae86058a6d8698833afb474ab8a5ad8599c6cf54f9ebcf275dbac7055c16fe1
# Пауза перед чтением таблиц после мутации (мс); 0 — без ожидания
POST_TRANSACT_CHAIN_READ_DELAY_MS=1000

# HISTORY API
SIMPLE_EXPLORER_API=http://127.0.0.1:4000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=voskhod

TIMEZONE=Europe/Moscow

NOVU_APP_ID=BTaPV0bRL0dz
NOVU_BACKEND_URL=https://novu.coopenomics.world/api
NOVU_SOCKET_URL=https://novu.coopenomics.world/ws
NOVU_API_KEY=201a45fa0d7493a3d53fa309bfb01c4fd

# MATRIX
MATRIX_HOMESERVER_URL=https://chat.coopenomics.world
MATRIX_CLIENT_URL=https://chatcoop.coopenomics.world
MATRIX_ADMIN_USERNAME=admin
MATRIX_COMMON_ROOM_ID=
MATRIX_ADMIN_PASSWORD=

SENTRY_DSN=
GITHUB_TOKEN=


LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ru

# FILE STORAGE (MinIO в dev compose; на prod подменяется плейбуком).
# Endpoint S3-совместимого бэкенда. В dev compose service name = minio.
# Для запуска контроллера на хосте (вне docker) — http://127.0.0.1:9000.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Имя физического бакета. По умолчанию `coop-${COOPNAME}`, можно перекрыть.
MINIO_BUCKET=
# HMAC-секрет для подписи URL отдачи. Если пусто — берётся SERVER_SECRET.
FILE_STORAGE_SIGNING_SECRET=
# База публичного URL для ссылок на файлы. Ссылку открывает браузер, который уже
# пришёл на стол и ходит на бэкенд по относительному /backend, поэтому база тоже
# относительная — так ссылка верна в любом контуре без настройки. Пусто — берётся
# BACKEND_URL, а он на деве указывает на внутренний порт контейнера, недоступный
# из браузера, и картинки не открываются.
FILE_STORAGE_PUBLIC_BASE_URL=/backend

# CoopID: админ-токен authentik. Контроллер заводит им учётку пайщика и ставит
# пароль при миграции «ключ→пароль» и при восстановлении доступа. В dev-компоузе
# секрет подключён к coopback, поэтому достаточно пути; в проде путь задаёт плейбук.
# Без этой переменной адаптер бросает явную ошибку конфигурации, а миграция — 500.
AUTHENTIK_ADMIN_TOKEN_FILE=/run/secrets/authentik_bootstrap_token

# Ключ, которым кооператив заверяет удостоверения пайщиков. Публичная часть
# публикуется в цепи правом `cert` аккаунта кооператива — без пары одно другому
# не соответствует и удостоверение выпустить нечем.
COOP_CERT_KEY_FILE=/run/secrets/coop_cert_key

# Внутренний адрес authentik в сети стенда: по нему контроллер ходит в OIDC-API
# (браузер при этом видит authentik по внешнему адресу через nginx стенда).
AUTHENTIK_INTERNAL_URL=http://authentik-server:9000

# Отдельная БД доменов кооперативов в общем сервисе postgres. Заводится
# init-скриптом на пустом томе (infra/coopid/postgres/init), пароль роли
# приезжает файлом-секретом. Без этих трёх строк миграция «coopid coop domain db
# init» падает на старте и контроллер не поднимается на неполной схеме.
COOP_DOMAIN_DB_HOST=postgres
COOP_DOMAIN_DB_PORT=5432
COOP_DOMAIN_DB_PASSWORD_FILE=/run/secrets/coop_pg_app_password

# Auth v2: секрет привязки сессии к устройству и токен вебхука authentik.
# Второй должен совпадать с COOPID_WEBHOOK_TOKEN корневого .env.
AUTH_V2_SESSION_BINDING_SECRET_FILE=/run/secrets/auth_v2_session_binding_secret
AUTH_V2_WEBHOOK_TOKEN_FILE=/run/secrets/authentik_webhook_token


# Прогонять непринятые миграции самому при старте. Нужно стендам: там база
# создаётся с нуля, и без миграций нет схемы CoopID (coop_domain_db). На проде
# НЕ включать — там миграции раскатывает релиз осознанно.
AUTO_MIGRATE=false

# Клиент card.coop в CoopID кооператива (карта пайщика, story 7.0/7.6). Значения те же, что
# получает authentik для блюпринта coopid-cardcoop-client; контроллер доносит их в реестр
# сети подписанным документом. Пустой секрет = самоподключение к сети карт пропускается.
CARDCOOP_CLIENT_ID=cardcoop
CARDCOOP_CLIENT_SECRET=
CARDCOOP_OIDC_ISSUER=
