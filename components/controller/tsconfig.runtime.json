{
  // Резолвинг алиасов `~/*` для запуска собранного кода: `tsconfig-paths`
  // читает именно этот файл (TS_NODE_PROJECT), потому что базовый tsconfig
  // указывает baseUrl на исходники, а в контейнере выполняется `dist/src`.
  "compilerOptions": {
    "baseUrl": "./dist/src",
    "paths": {
      "~/*": ["*"]
    }
  }
}
