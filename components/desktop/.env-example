NODE_ENV=development
# Относительный путь: фронт, бэкенд и authentik за одним nginx, поэтому адрес
# бэкенда origin-независим — работает и через localhost, и через IP, и по домену.
BACKEND_URL=/backend
CHAIN_URL=/api
CHAIN_ID=cae86058a6d8698833afb474ab8a5ad8599c6cf54f9ebcf275dbac7055c16fe1
CURRENCY=RUB
COOP_SHORT_NAME=Локальный Кооператив
SITE_DESCRIPTION=кооперативная экономика для сообществ и бизнеса
SITE_IMAGE=https://ia.media-imdb.com/images/rock.jpg
TIMEZONE=Europe/Moscow
NOVU_APP_ID=BTaPV0bRL0dz
NOVU_BACKEND_URL=https://novu.coopenomics.world/api
NOVU_SOCKET_URL=https://novu.coopenomics.world/ws
SENTRY_DSN=
OPENREPLAY_PROJECT_KEY=

# Контур CoopID (вход по паролю). Пока не заданы — стол остаётся на входе по
# ключу, а путь пароля отдаёт понятную ошибку вместо поломки.
# ISSUER берётся из discovery authentik и включает порт, если стенд открыт по нему.
COOPID_ISSUER=http://localhost:8088/application/o/coopid/
COOPID_CLIENT_ID=coopid-desktop
