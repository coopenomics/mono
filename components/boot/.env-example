# Узел цепи этого чекаута. Без переменной boot по умолчанию идёт на
# 127.0.0.1:8888 — это узел другого чекаута, и правки уходят в чужую цепь молча,
# без единого предупреждения.
CHAIN_URL=http://127.0.0.1:8888

# Ключи DaData для dev-стенда: с ними сид ставит расширение «Анкета по ИНН»
# включённым. Пусто — расширение остаётся в каталоге, председатель ставит его сам.
# Ключи — из личного кабинета DaData, в репозиторий не коммитить.
DADATA_API_KEY=
DADATA_SECRET_KEY=
