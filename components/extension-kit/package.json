    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.1",
    "@nestjs/passport": "^10.0.3",
    "rxjs": "^7.0.0",
    "typescript": "^5.4.5",
    "unbuild": "^2.0.0",
    "zod": "^3.0.0"
  }
}
