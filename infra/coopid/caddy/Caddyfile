# Edge-вход кооператива (CoopID). TLS 1.3 минимум; внутрь сети — plain HTTP.
# COOPID_DOMAIN=localhost (dev) даёт self-signed сертификат внутреннего CA;
# реальный домен автоматически получает Let's Encrypt.

{
	admin off
}

{$COOPID_DOMAIN:localhost} {
	tls {
		protocols tls1.3
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}

	# REST/GraphQL controller'а — до общего catch-all.
	handle /api/coopback/* {
		uri strip_prefix /api/coopback
		reverse_proxy coopback:2998
	}

	# Стандартный корневой OIDC discovery (Story 5.1). authentik отдаёт его по
	# /application/o/coopid/...; RP ждут корневой /.well-known/* — пробрасываем
	# с rewrite (Host сохраняется → issuer/endpoints в доке строятся по домену
	# кооператива). jwks.json — алиас на authentik /jwks/.
	handle /.well-known/openid-configuration {
		rewrite * /application/o/coopid/.well-known/openid-configuration
		reverse_proxy authentik-server:9000
	}
	handle /.well-known/jwks.json {
		rewrite * /application/o/coopid/jwks/
		reverse_proxy authentik-server:9000
	}

	# Всё остальное — OIDC Provider (authentik UI, /application/o/*, flows).
	handle {
		reverse_proxy authentik-server:9000
	}
}
