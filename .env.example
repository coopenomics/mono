# Шаблон per-instance конфига. Скопируй в .env и подправь под свой инстанс.
#
# Зачем: docker-compose.yaml и boot-скрипты параметризованы — это
# позволяет держать несколько копий репо (mono-ai-1, mono-ai-2 ...) с
# полностью изолированной инфраструктурой и запускать их параллельно.
#
# Без .env compose поднимется с дефолтами (как у mono-ai-1).
# Дефолты ниже соответствуют первому инстансу — для второго и далее
# применяй смещение portов: offset = (INSTANCE_INDEX - 1) * 10.

# Индекс инстанса (1 = базовый, 2/3/... = параллельные копии).
INSTANCE_INDEX=1

# Имя docker compose проекта. Определяет префикс автогенерируемых
# имён контейнеров (mongo → <COMPOSE_PROJECT_NAME>-mongo-1).
# По умолчанию compose возьмёт имя папки — оставь как есть, если папка
# уже называется уникально (например, mono-ai-1).
COMPOSE_PROJECT_NAME=mono-ai-1

# Host-порты (для INSTANCE_INDEX=2 прибавь +10 к каждому, для =3 +20 и т.д.).
NODE_HTTP_PORT=8888
NODE_P2P_PORT=9876
NODE_HISTORY_PORT=8070
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
PG_HOST_PORT=5532
COOPBACK_HOST_PORT=2998
DESKTOP_HOST_PORT=2999
OPENSEARCH_HOST_PORT=9200
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# MinIO root credentials (только для локального dev; на prod подменяются плейбуком).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# URL для скриптов и кода, запускаемого с хоста (boot, networks.sh,
# preactivate.sh, health.ts). Должны соответствовать host-портам выше.
CHAIN_URL=http://127.0.0.1:8888
API_URL=http://127.0.0.1:2998/v1/graphql
MONGODB_URL=mongodb://127.0.0.1:27017

# --- CoopID (overlays docker-compose.authentik.yml + docker-compose.edge.yml) ---
# Поднимаются только явной цепочкой -f (см. infra/coopid/README.md);
# перед первым запуском: bash scripts/coopid-gen-secrets.sh
# К портам применяется то же правило offset = (INSTANCE_INDEX - 1) * 10.
COOP_PG_HOST_PORT=5632
AUTHENTIK_HOST_PORT=9008
# Единый вход dev-контура (nginx). Один порт вместо трёх: фронт, бэкенд и
# authentik отвечают с одного адреса — иначе браузер не отдаст куки authentik
# при входе по паролю. Под SSH-туннель пробрасывается именно он.
NGINX_HOST_PORT=8088
# Домен кооператива для caddy: localhost = dev self-signed; реальный домен = Let's Encrypt.


# Адрес возврата рабочего стола для контура CoopID. Подставляется в blueprint
# authentik; обязан совпадать с тем, что видит браузер, символ в символ —
# authentik сверяет его точно. Меняется вместе с тем, как открыт стенд.
COOPID_REDIRECT_URI=http://localhost:8088/auth/callback.html

# Бутстрап authentik: под этим паролем заводится администратор akadmin, а токен
# отдаётся контроллеру (AUTHENTIK_ADMIN_TOKEN_FILE) для заведения учётных записей
# пайщиков. Значения — любые случайные строки; те же самые кладёт в
# infra/coopid/secrets скрипт scripts/coopid-gen-secrets.sh. Пустые = authentik
# поднимется без администратора, и вход по паролю настроить будет нечем.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# Токен вебхука authentik → controller: им подписаны события учётной записи
# (смена пароля, блокировка). Должен совпадать с AUTH_V2_WEBHOOK_TOKEN_FILE
# контроллера, иначе события молча отбрасываются.
COOPID_WEBHOOK_TOKEN=

# Клиент card.coop в CoopID кооператива (карта пайщика, Story 7.0). Секрет
# генерирует scripts/coopid-gen-secrets.sh; пустой = блюпринт клиента намеренно
# не применяется, и federated-вход на card.coop через этот кооператив невозможен.
# CARDCOOP_BASE_URL — адрес card.coop, из него и имени кооператива собирается
# адрес возврата (authentik card.coop принимает ответ на
# /source/oauth/callback/<coopname>/). COOPNAME обязан совпадать с именем
# аккаунта кооператива в цепи — под ним же кооператив заведён в реестре АНО.
CARDCOOP_CLIENT_ID=cardcoop
CARDCOOP_CLIENT_SECRET=
CARDCOOP_BASE_URL=https://card.coop
COOPNAME=voskhod
